# Optional commercial odds feed (NBA; coverage for CBA/LoL/CS2 must be checked on the account plan)
ODDS_API_KEY=
ODDS_API_REGIONS=us,eu

# Safety defaults
BANKROLL=1000
BANKROLL_USDC=1000
REPORT_TIMEZONE=Asia/Singapore
DAILY_RUN_TIME=06:30
RUN_ON_START=false
PORT=8080
MAX_BET_FRACTION=0.0075
MAX_DAILY_RISK_FRACTION=0.025
KELLY_FRACTION=0.25
MAX_EVENT_RISK_FRACTION=0.01
MAX_DRAWDOWN_FRACTION=0.10

# Feishu delivery: simplest option is a group custom-bot webhook.
FEISHU_WEBHOOK_URL=
FEISHU_WEBHOOK_SECRET=

# Or use a self-built app bot for a direct message to your account.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_RECEIVE_ID=
FEISHU_RECEIVE_ID_TYPE=open_id

# One direct CSV URL per line. Use 2020-2026 Oracle's Elixir exports or a
# private object-store mirror you control. Never put signed URLs in Git.
LOL_DATA_URLS=
# Append-only forward prediction ledger (inside the persistent data volume)
PAPER_DB_PATH=/app/data/daily/paper.db
PAPER_SCAN_MINUTES=30
MARKET_HORIZON_HOURS=30

# Continuous live monitoring (research only; never enables real-money trading).
LIVE_SCAN_SECONDS=30
LIVE_DB_PATH=/app/data/daily/live.db
WATCHER_REGISTRY_PATH=/app/data/daily/watcher_registry.json

# Riot LoL Esports schedule/live feed. The key is required by the LoL Esports client API.
LOLESPORTS_API_KEY=
# Optional explicit IDs; when blank, target league IDs are discovered dynamically.
LOLESPORTS_LEAGUE_IDS=
LOL_TARGET_LEAGUES=LPL,LCK,LEC,LTA,MSI,Worlds,First Stand
LOL_CURRENT_PATCH=unknown

# GRID Open Access: free registration for eligible non-commercial CS2 research.
GRID_API_KEY=
CS2_MAX_TIER_RANK=2

# PandaScore free token supplies fixtures/running match scores; detailed live frames require a live plan.
PANDASCORE_TOKEN=

# Optional comma-separated RSS feeds for injuries, lineups, roster changes, and announcements.
NEWS_RSS_URLS=https://www.espn.com/espn/rss/nba/news
