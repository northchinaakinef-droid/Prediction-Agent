# Optional commercial odds feed (NBA; coverage for CBA/LoL/CS2 must be checked on the account plan)
ODDS_API_KEY=
ODDS_API_REGIONS=us,eu

# Safety defaults
BANKROLL=1000
BANKROLL_USDC=1000
REPORT_TIMEZONE=Asia/Shanghai
DAILY_RUN_TIME=08:15
RUN_ON_START=false
PORT=8080
MAX_BET_FRACTION=0.0075
MAX_DAILY_RISK_FRACTION=0.025
KELLY_FRACTION=0.25
MAX_EVENT_RISK_FRACTION=0.01
MAX_DRAWDOWN_FRACTION=0.10

# Feishu delivery: simplest option is a group custom-bot webhook.
FEISHU_WEBHOOK_URL=
FEISHU_WEBHOOK_SECRET=

# Or use a self-built app bot for a direct message to your account.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_RECEIVE_ID=
FEISHU_RECEIVE_ID_TYPE=open_id

# One direct CSV URL per line. Use 2020-2026 Oracle's Elixir exports or a
# private object-store mirror you control. Never put signed URLs in Git.
LOL_DATA_URLS=
